# Copy to .env (git-ignored). Generate secrets with: openssl rand -hex 32
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Postgres superuser: given only to db, init and tools containers, never the API.
ADMIN_DB_USER=brain
ADMIN_DB_PASSWORD=
# Password of the control-plane role the API uses.
APP_CONTROL_PASSWORD=
# Derives each tenant role's database password (HMAC). Rotating it means re-setting
# every tenant role's password.
TENANT_DB_KEY=

APP_ORIGIN=http://localhost:5173
ENV=development

# Real sign-in providers (redirect URIs: $APP_ORIGIN/api/auth/callback/google and
# $APP_ORIGIN/api/auth/callback/microsoft). Leave empty to disable a provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Local test identity provider (docker compose --profile dev). Development and tests
# only; the backend refuses to start with these set when ENV=production.
MOCK_OIDC_URL=http://mock-oidc:8080
MOCK_OIDC_PUBLIC_URL=http://localhost:8081
