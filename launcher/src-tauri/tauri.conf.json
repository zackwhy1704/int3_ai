{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Company Brain",
  "version": "0.1.0",
  "identifier": "com.companybrain.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Company Brain",
        "width": 920,
        "height": 640,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "generalAutofillEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "publisher": "Company Brain",
    "shortDescription": "Company Brain launcher",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
