# The one place hosted settings live. No secrets here (this repo is public).
#
# INT3_BASE_DOMAIN is THE base domain setting: every public hostname is derived from it as
# <random-id>.$INT3_BASE_DOMAIN and nothing else names the domain. The owner adds one DNS record
# by hand at Porkbun: A  *.app  ->  the static IP. .app is on the HSTS preload list, so everything
# is https; there is no plain-http listener or fallback (port 80 is closed).
INT3_BASE_DOMAIN=app.int3labs.app

GCP_PROJECT=int3-513810
GCP_REGION=asia-southeast1
GCP_ZONE=asia-southeast1-b

INT3_VM=int3-pilot
INT3_MACHINE=e2-highmem-2     # 2 vCPU, 16 GB. Sized in RUNBOOK.md from measured per-user memory.
INT3_DISK_GB=50
INT3_ADDRESS=int3-pilot-ip
INT3_NETWORK=int3-net
INT3_SUBNET_RANGE=10.60.0.0/24
INT3_SA=int3-pilot-vm
INT3_BUCKET=int3-513810-int3-backups
INT3_BACKUP_DAYS=30

INT3_REPO=https://github.com/zackwhy1704/int3_ai.git
INT3_REF=spike/remote-thin-client

# Compose project / container namespace on the VM.
DEPLOY_PROJECT=int3
