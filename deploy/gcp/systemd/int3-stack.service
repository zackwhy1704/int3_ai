[Unit]
Description=int3 shared stack (secrets from Secret Manager, then compose up)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash /opt/int3/deploy/gcp/vm/stack-up.sh
# First boot builds the pinned Hermes image.
TimeoutStartSec=3600

[Install]
WantedBy=multi-user.target
