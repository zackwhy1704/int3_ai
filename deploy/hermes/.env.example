# Copy to .env (never committed) and fill in. All values are secrets except
# where noted. Generate random ones with the commands shown.

# Postgres superuser (control DB owner). Used by db, init, and provision-user.sh.
ADMIN_DB_USER=brain
#   openssl rand -hex 32
ADMIN_DB_PASSWORD=

# Password for the app_control DB role (the brain's runtime role).
#   openssl rand -hex 32
APP_CONTROL_PASSWORD=

# Key that encrypts each tenant database's at-rest secrets.
#   openssl rand -hex 32
TENANT_DB_KEY=

# Password for the least-privilege gateway_auth DB role (SELECT on service_tokens
# + tenant_providers, write only on tenant_usage). init creates the role with it;
# the gateway connects with it.
#   openssl rand -hex 32
GATEWAY_DB_PASSWORD=

# Envelope-encryption KEK that wraps each tenant's provider key (base64, 32 bytes).
#   openssl rand -base64 32
TENANT_KEY_KEK=

# The model-provider key the gateway injects for the tenant (key_owner=ours in
# this pilot). Kept server-side only; never reaches a Hermes container.
ANTHROPIC_API_KEY=

# MVP model (not a secret). claude-haiku-5-5 is pending stricter eval — see
# eval/README.md — so leave this on sonnet.
ANTHROPIC_MODEL=claude-sonnet-5-5

# ENV (not a secret). Keep development for the local pilot.
ENV=development

# Egress proxy allowlist (not a secret). Empty = deny-all, the pilot default: a
# user backend reaches only the brain + gateway, nothing on the internet.
EGRESS_ALLOW=
